# Environment
NODE_ENV=development
PORT=5000

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/academy_lms?schema=public"

# Auth Secrets
JWT_ACCESS_SECRET="your_jwt_access_secret_key_min_32_chars"
JWT_REFRESH_SECRET="your_jwt_refresh_secret_key_min_32_chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Client URL (for CORS and Cookies)
CLIENT_URL="http://localhost:3000"

# App Public URL
APP_URL="http://localhost:5000"

# Storage
STORAGE_DRIVER="local"
UPLOAD_DIR="./uploads"

# Payment Providers
PAYMENT_PROVIDER="MOCK"
RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET="rzp_secret_placeholder"
