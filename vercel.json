{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "services": {
    "web": {
      "root": "apps/web/",
      "framework": "nextjs"
    },

    "api": {
      "root": "apps/api/",
      "framework": "express"
    }
  },

  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}