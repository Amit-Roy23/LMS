# /srv/adsign/.env  (chmod 600; never commit real values)
NODE_ENV=production

# Database (from /root/adsign-db-credentials.txt)
DATABASE_URL=postgresql://adsign:CHANGE_ME@127.0.0.1:5432/adsign_lms
DIRECT_URL=postgresql://adsign:CHANGE_ME@127.0.0.1:5432/adsign_lms

# Site addresses
CLIENT_URL=https://academy.example.com
NEXT_PUBLIC_SITE_URL=https://academy.example.com
INTERNAL_API_URL=http://127.0.0.1:5000/api/v1

# Secrets: generate each with `openssl rand -hex 32`
JWT_SECRET=
APP_SIGNING_SECRET=

# Razorpay (Dashboard → Account & Settings → API keys / Webhooks)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# SMS OTP via MSG91 (DLT registered sender and template)
SMS_PROVIDER=MSG91
MSG91_AUTH_KEY=
MSG91_SENDER_ID=ADSIGN
SMS_DLT_TE_ID=
OTP_DEMO_MODE=false

# Email (any SMTP: Hostinger mail, Zoho, Brevo, SES)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ADSIGN Skill Academy <no-reply@academy.example.com>"

# Enquiry alerts
ADMISSIONS_EMAILS=admissions@academy.example.com
ADMISSIONS_WHATSAPP=

# GST invoice details
INVOICE_SELLER_NAME="ADSIGN Skill Academy"
INVOICE_GSTIN=
INVOICE_ADDRESS=
INVOICE_STATE="West Bengal"
INVOICE_STATE_CODE=19
INVOICE_EMAIL=
INVOICE_PHONE=
NEXT_PUBLIC_INVOICE_STATE="West Bengal"

# Contact details shown on the website and policies
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_ACADEMY_ADDRESS=

# Security limits
MAX_ADMINS=3
DEVICE_LIMIT_MOBILE=1
DEVICE_LIMIT_DESKTOP=1

# Marketing analytics (optional)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Off-server backups (rclone remote name, e.g. "b2:adsign-backups" after `rclone config`)
BACKUP_REMOTE=
