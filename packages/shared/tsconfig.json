{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "baseUrl": ".",
    "paths": {
      "@academy/shared": ["./src/index.ts"],
      "@academy/shared/*": ["./src/*"]
    }
  },
  "include": ["src/**/*"]
}
